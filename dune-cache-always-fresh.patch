From ed7fbe7661b92d382bd6d3eae30cd39c02acc1e2 Mon Sep 17 00:00:00 2001
From: Robin <robin.lewis@anterior.com>
Date: Sat, 9 May 2026 02:39:53 -0400
Subject: [PATCH] feat: --cache-always-fresh build flag

For Nix
---
 bin/common.ml                 | 17 +++++++++++++++++
 src/dune_engine/clflags.ml    |  1 +
 src/dune_engine/clflags.mli   |  3 +++
 src/dune_engine/rule_cache.ml |  2 +-
 4 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/bin/common.ml b/bin/common.ml
index 7cfd8d8d3..5cc1f4a87 100644
--- a/bin/common.ml
+++ b/bin/common.ml
@@ -598,6 +598,7 @@ module Builder = struct
     { no_build : No_build.t
     ; debug_dep_path : bool
     ; debug_package_logs : bool
+    ; cache_always_fresh : bool
     ; wait_for_filesystem_clock : bool
     ; only_packages : Only_packages.Clflags.t
     ; capture_outputs : bool
@@ -919,6 +920,18 @@ module Builder = struct
                   drop anything. You should probably not care about this option; it is \
                   mostly useful for Dune developers to make Dune tests of the digest \
                   cache more reproducible."))
+    and+ cache_always_fresh =
+      Arg.(
+        value
+        & flag
+        & info
+            [ "cache-always-fresh" ]
+            ~doc:
+              (Some
+                 "Consider any existing cache entry fresh, regardless of metadata. \
+                  Highly risky option, never use interactively, useful for Nix and \
+                  similar build systems where you have full control over the cache \
+                  and wish to avoid any cache invalidations ever."))
     and+ report_errors_config =
       Arg.(
         value
@@ -956,6 +969,7 @@ module Builder = struct
     { no_build
     ; debug_dep_path
     ; debug_package_logs
+    ; cache_always_fresh
     ; wait_for_filesystem_clock
     ; only_packages
     ; capture_outputs = not no_buffer
@@ -1008,6 +1022,7 @@ module Builder = struct
         { no_build
         ; debug_dep_path
         ; debug_package_logs
+        ; cache_always_fresh
         ; wait_for_filesystem_clock
         ; only_packages
         ; capture_outputs
@@ -1040,6 +1055,7 @@ module Builder = struct
     No_build.equal t.no_build no_build
     && Bool.equal t.debug_dep_path debug_dep_path
     && Bool.equal t.debug_package_logs debug_package_logs
+    && Bool.equal t.cache_always_fresh cache_always_fresh
     && Bool.equal t.wait_for_filesystem_clock wait_for_filesystem_clock
     && Only_packages.Clflags.equal t.only_packages only_packages
     && Bool.equal t.capture_outputs capture_outputs
@@ -1293,6 +1309,7 @@ let init_with_root ~(root : Workspace_root.t) (builder : Builder.t) =
   Report_error.print_memo_stacks := c.builder.debug_dep_path;
   Dune_engine.Clflags.report_errors_config := c.builder.report_errors_config;
   Dune_rules.Clflags.debug_package_logs := c.builder.debug_package_logs;
+  Dune_engine.Clflags.cache_always_fresh := c.builder.cache_always_fresh;
   Dune_engine.Clflags.wait_for_filesystem_clock := c.builder.wait_for_filesystem_clock;
   Dune_engine.Clflags.capture_outputs := c.builder.capture_outputs;
   Dune_engine.Clflags.diff_command := c.builder.diff_command;
diff --git a/src/dune_engine/clflags.ml b/src/dune_engine/clflags.ml
index 5c63238eb..66d477838 100644
--- a/src/dune_engine/clflags.ml
+++ b/src/dune_engine/clflags.ml
@@ -31,4 +31,5 @@ let always_show_command_line = ref false
 let display = ref Display.Quiet
 let can_go_in_shared_cache_default = ref false
 let diff_command = ref None
+let cache_always_fresh = ref false
 let wait_for_filesystem_clock = ref false
diff --git a/src/dune_engine/clflags.mli b/src/dune_engine/clflags.mli
index a887327b5..da11d6daf 100644
--- a/src/dune_engine/clflags.mli
+++ b/src/dune_engine/clflags.mli
@@ -41,6 +41,9 @@ val can_go_in_shared_cache_default : bool ref
 (** Command to use to diff files *)
 val diff_command : string option ref
 
+(** Pretend any cache entry found, is always a fresh one *)
+val cache_always_fresh : bool ref
+
 (** Wait for the filesystem clock to advance rather than dropping cached digest
     entries *)
 val wait_for_filesystem_clock : bool ref
diff --git a/src/dune_engine/rule_cache.ml b/src/dune_engine/rule_cache.ml
index b96a77fbd..fb9164d2a 100644
--- a/src/dune_engine/rule_cache.ml
+++ b/src/dune_engine/rule_cache.ml
@@ -231,7 +231,7 @@ module Workspace_local = struct
       with
       | None -> Miss Miss_reason.No_previous_record
       | Some prev_trace ->
-        (match Digest.equal prev_trace.rule_digest rule_digest with
+        (match !Clflags.cache_always_fresh || (Digest.equal prev_trace.rule_digest rule_digest) with
          | false -> Miss (Miss_reason.Rule_changed (prev_trace.rule_digest, rule_digest))
          | true ->
            (* [compute_target_digests] returns a [Miss] if not all targets are
-- 
2.51.2

